---
import logoMark from "../assets/logo-mark.svg?raw";
const currentPath = Astro.url.pathname;
---

<nav
  class="fixed top-0 w-full z-50 glass border-b border-white/10 transition-all duration-300"
  id="main-navbar"
>
  <div class="container mx-auto px-6 py-4 flex justify-between items-center">
    <a href="/" class="flex items-center gap-2 group z-50 relative">
      <span
        class="inline-block w-9 h-9 group-hover:scale-110 transition-transform drop-shadow-glow-sm"
        aria-label="Dakodev"
        set:html={logoMark}
      />
      <span class="font-wordmark font-bold text-2xl tracking-tight text-white"
        >Dakodev</span
      >
    </a>

    <!-- Desktop Menu -->
    <div
      class="hidden md:flex gap-8 text-sm font-medium uppercase tracking-widest text-gray-400 items-center"
    >
      <a href="/" class:list={["hover:text-accent-cyan transition-colors py-3", currentPath === "/" && "text-accent-cyan"]}>Inicio</a>
      <a href="/servicios/" class:list={["hover:text-accent-cyan transition-colors py-3", currentPath.startsWith("/servicios") && "text-accent-cyan"]}
        >Servicios</a
      >
      <a href="/contacto/" class:list={["hover:text-accent-cyan transition-colors py-3", currentPath.startsWith("/contacto") && "text-accent-cyan"]}
        >Contacto</a
      >
    </div>

    <a
      href="/contacto/"
      class="hidden md:block px-6 py-2 bg-accent-cyan text-dark font-bold rounded-full hover:bg-white hover:scale-105 hover:shadow-glow transition-all duration-300 shadow-lg shadow-accent-cyan/20 active:scale-95"
    >
      Empecemos
    </a>

    <!-- Mobile Menu Button -->
    <button
      id="menu-toggle"
      class="md:hidden text-white relative"
      aria-label="Alternar menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <div class="w-8 h-8 flex flex-col justify-center gap-1.5">
        <span
          class="block w-8 h-0.5 bg-current transition-all duration-300 origin-center"
          id="hamburger-top"></span>
        <span
          class="block w-8 h-0.5 bg-current transition-all duration-300"
          id="hamburger-middle"></span>
        <span
          class="block w-8 h-0.5 bg-current transition-all duration-300 origin-center"
          id="hamburger-bottom"></span>
      </div>
    </button>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<!-- Moving outside nav to escape backdrop-blur stacking context and ensure full viewport height -->
<nav
  id="mobile-menu"
  aria-label="Navegación móvil"
  inert
  class="fixed inset-0 bg-dark/60 backdrop-blur-xl z-40 flex flex-col items-center justify-start pt-32 space-y-8 opacity-0 pointer-events-none transition-all duration-500 transform translate-y-4"
>
  <a
    href="/"
    class="text-2xl font-bold text-white hover:text-accent-cyan transition-colors mobile-link"
    >Inicio</a
  >
  <a
    href="/servicios/"
    class="text-2xl font-bold text-white hover:text-accent-cyan transition-colors mobile-link"
    >Servicios</a
  >
  <a
    href="/contacto/"
    class="text-2xl font-bold text-white hover:text-accent-cyan transition-colors mobile-link"
    >Contacto</a
  >
  <a
    href="/contacto/"
    class="px-8 py-3 bg-accent-cyan text-dark font-bold rounded-full hover:bg-white transition-all shadow-lg mobile-link"
  >
    Empecemos
  </a>
</nav>

<script>
  const setupNavbar = () => {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerTop = document.getElementById("hamburger-top");
    const hamburgerMiddle = document.getElementById("hamburger-middle");
    const hamburgerBottom = document.getElementById("hamburger-bottom");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (
      !menuToggle ||
      !mobileMenu ||
      !hamburgerTop ||
      !hamburgerMiddle ||
      !hamburgerBottom
    )
      return;

    // El <nav> tiene transition:persist, así que sobrevive a los swaps de
    // View Transitions: sin este guard cada navegación sumaba otro listener
    // de click sobre los mismos nodos.
    if (menuToggle.dataset.bound === "true") return;
    menuToggle.dataset.bound = "true";

    let isMenuOpen = false;

    const setMenu = (open: boolean) => {
      isMenuOpen = open;
      menuToggle.setAttribute("aria-expanded", String(open));

      if (open) {
        mobileMenu.classList.remove(
          "opacity-0",
          "pointer-events-none",
          "translate-y-4",
        );
        // Cerrado, sus links seguían siendo tabulables aunque no se vieran.
        mobileMenu.removeAttribute("inert");
        document.body.style.overflow = "hidden"; // Prevent scrolling

        // Animate Hamburger
        hamburgerTop.classList.add("rotate-45", "translate-y-2");
        hamburgerMiddle.classList.add("opacity-0");
        hamburgerBottom.classList.add("-rotate-45", "-translate-y-2");
      } else {
        mobileMenu.classList.add(
          "opacity-0",
          "pointer-events-none",
          "translate-y-4",
        );
        mobileMenu.setAttribute("inert", "");
        document.body.style.overflow = ""; // Restore scrolling

        // Reset Hamburger
        hamburgerTop.classList.remove("rotate-45", "translate-y-2");
        hamburgerMiddle.classList.remove("opacity-0");
        hamburgerBottom.classList.remove("-rotate-45", "-translate-y-2");
      }
    };

    const toggleMenu = () => setMenu(!isMenuOpen);

    menuToggle.addEventListener("click", toggleMenu);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isMenuOpen) {
        setMenu(false);
        menuToggle.focus();
      }
    });

    // Close menu when clicking a link
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isMenuOpen) setMenu(false);
      });
    });

    // Navegar con el menú abierto dejaba la página siguiente sin scroll.
    document.addEventListener("astro:before-swap", () => {
      document.body.style.overflow = "";
    });
  };

  // Run on initial load and after view transitions
  document.addEventListener("astro:page-load", setupNavbar);
</script>
