---

---

<section
  id="mision-vision-valores"
  aria-labelledby="mvv-heading"
  class="relative overflow-hidden"
>
  <!-- Decorative parallax orbs -->
  <div
    id="mvv-orb-1"
    class="absolute top-1/4 -left-40 w-[500px] h-[500px] bg-accent-cyan/10 rounded-full blur-[100px] z-0 pointer-events-none"
  >
  </div>
  <div
    id="mvv-orb-2"
    class="absolute bottom-1/4 -right-40 w-[500px] h-[500px] bg-accent-teal/10 rounded-full blur-[100px] z-0 pointer-events-none"
  >
  </div>

  <!-- STAGE 1: MISIÓN -->
  <div class="pt-32 pb-20 relative" id="mvv-mision-stage">
    <div class="container mx-auto px-6 relative z-10">
      <span
        class="text-accent-cyan font-bold tracking-widest uppercase text-sm mb-4 block mvv-trigger opacity-0 reveal-up-sm"
        id="mvv-badge"
      >
        Misión, Visión & Valores
      </span>

      <div class="max-w-5xl" id="mvv-mision-block">
        <h2
          id="mvv-heading"
          class="font-heading text-5xl md:text-7xl lg:text-8xl font-bold mb-8 leading-none mvv-trigger opacity-0 reveal-up-sm"
        >
          <span class="text-gradient glow-text">MISIÓN</span>
        </h2>

        <p
          id="mvv-mision-text"
          class="text-gray-300 text-xl md:text-2xl lg:text-3xl leading-relaxed lg:leading-snug font-normal max-w-4xl mvv-trigger opacity-0 reveal-up-sm"
        >
          Diseñamos e implementamos soluciones de software empresarial para
          maximizar el potencial de las empresas en crecimiento, con la
          excelencia de las grandes consultoras a un precio competitivo.
        </p>

        <div
          id="mvv-mision-line"
          class="h-1 bg-linear-to-r from-accent-cyan to-accent-blue rounded-full mt-8 w-0"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- STAGE 2: VISIÓN -->
  <div class="py-20 relative" id="mvv-vision-stage">
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-5xl ml-auto text-right" id="mvv-vision-block">
        <h2
          class="font-heading text-5xl md:text-7xl lg:text-8xl font-bold mb-8 leading-none mvv-trigger opacity-0 reveal-up-sm"
        >
          <span class="text-gradient glow-text">VISIÓN</span>
        </h2>

        <p
          id="mvv-vision-text"
          class="text-gray-300 text-xl md:text-2xl lg:text-3xl leading-relaxed lg:leading-snug font-normal max-w-4xl ml-auto mvv-trigger opacity-0 reveal-up-sm"
        >
          Ser el partner tecnológico de referencia para las empresas y negocios
          de habla hispana que buscan digitalizar su negocio con tecnología de
          primer nivel y atención de calidad humana.
        </p>

        <div
          id="mvv-vision-line"
          class="h-1 bg-linear-to-r from-accent-cyan to-accent-blue rounded-full mt-8 w-0 ml-auto"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- STAGE 3: VALORES -->
  <div class="py-20 pb-32 relative" id="mvv-valores-stage">
    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <h2
          class="font-heading text-5xl md:text-7xl lg:text-8xl font-bold leading-none mvv-trigger opacity-0 reveal-zoom"
          id="mvv-valores-heading"
        >
          <span class="text-gradient glow-text">VALORES</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Valor 1 -->
        <div
          class="glass p-8 rounded-3xl border border-white/10 hover:border-accent-cyan/50 transition-colors duration-500 mvv-valor-card opacity-0 reveal-up group relative flex items-center gap-5"
        >
          <div
            aria-hidden="true"
            class="shrink-0 w-12 h-12 rounded-xl bg-accent-cyan/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
          >
            <span
              class="text-accent-cyan font-heading font-bold text-xl"
              id="mvv-counter-1">01</span
            >
          </div>
          <h3 class="font-heading text-lg md:text-xl font-semibold text-gray-200">
            Comunicación clara y compromiso real.
          </h3>
        </div>

        <!-- Valor 2 -->
        <div
          class="glass p-8 rounded-3xl border border-white/10 hover:border-accent-blue/50 transition-colors duration-500 mvv-valor-card opacity-0 reveal-up group relative flex items-center gap-5"
        >
          <div
            aria-hidden="true"
            class="shrink-0 w-12 h-12 rounded-xl bg-accent-blue/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
          >
            <span
              class="text-accent-blue font-heading font-bold text-xl"
              id="mvv-counter-2">02</span
            >
          </div>
          <h3 class="font-heading text-lg md:text-xl font-semibold text-gray-200">
            Trabajo de calidad con excelencia técnica.
          </h3>
        </div>

        <!-- Valor 3 -->
        <div
          class="glass p-8 rounded-3xl border border-white/10 hover:border-accent-teal/50 transition-colors duration-500 mvv-valor-card opacity-0 reveal-up group relative flex items-center gap-5"
        >
          <div
            aria-hidden="true"
            class="shrink-0 w-12 h-12 rounded-xl bg-accent-teal/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
          >
            <span
              class="text-accent-teal font-heading font-bold text-xl"
              id="mvv-counter-3">03</span
            >
          </div>
          <h3 class="font-heading text-lg md:text-xl font-semibold text-gray-200">
            Proactividad.
          </h3>
        </div>

        <!-- Valor 4 -->
        <div
          class="glass p-8 rounded-3xl border border-white/10 hover:border-accent-cyan/50 transition-colors duration-500 mvv-valor-card opacity-0 reveal-up group relative flex items-center gap-5"
        >
          <div
            aria-hidden="true"
            class="shrink-0 w-12 h-12 rounded-xl bg-accent-cyan/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
          >
            <span
              class="text-accent-cyan font-heading font-bold text-xl"
              id="mvv-counter-4">04</span
            >
          </div>
          <h3 class="font-heading text-lg md:text-xl font-semibold text-gray-200">
            Crecimiento compartido.
          </h3>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import {
    armScramble,
    freezeScramble,
    playScramble,
    prefersReducedMotion,
  } from "../lib/scramble";

  gsap.registerPlugin(ScrollTrigger);

  const initMVVAnimations = () => {
    const root = document.getElementById("mision-vision-valores");
    if (!root) return;

    // Astro dispara astro:page-load también en la carga inicial, así que esto
    // corría dos veces por página. El flag vive en el DOM porque View
    // Transitions reemplaza el nodo en cada navegación.
    if (root.dataset.animated === "true") {
      ScrollTrigger.refresh();
      return;
    }
    root.dataset.animated = "true";

    // Con movimiento reducido el CSS ya revela todo: no se anima nada y los
    // contadores quedan directamente en su valor final.
    if (prefersReducedMotion()) {
      ["01", "02", "03", "04"].forEach((v, i) => {
        const el = document.getElementById(`mvv-counter-${i + 1}`);
        if (el) el.textContent = v;
      });
      return;
    }

    // Kill only this section's ScrollTriggers
    ScrollTrigger.getAll()
      .filter((st: any) => st.vars?.id?.startsWith("mvv-"))
      .forEach((st) => st.kill());

    // ── PARALLAX: Decorative orbs ──
    gsap.to("#mvv-orb-1", {
      scrollTrigger: {
        id: "mvv-orb1",
        trigger: "#mision-vision-valores",
        start: "top bottom",
        end: "bottom top",
        scrub: 1,
      },
      y: -200,
      x: 100,
      ease: "none",
    });

    gsap.to("#mvv-orb-2", {
      scrollTrigger: {
        id: "mvv-orb2",
        trigger: "#mision-vision-valores",
        start: "top bottom",
        end: "bottom top",
        scrub: 1,
      },
      y: 200,
      x: -100,
      ease: "none",
    });

    // ── STAGE 1: MISIÓN ──

    // Badge
    gsap.to("#mvv-badge", {
      scrollTrigger: {
        id: "mvv-badge",
        trigger: "#mvv-badge",
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
      y: 0,
      opacity: 1,
      duration: 1,
      ease: "power3.out",
    });

    // Mision heading
    gsap.to("#mvv-mision-block h2", {
      scrollTrigger: {
        id: "mvv-mision-h2",
        trigger: "#mvv-mision-block",
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
      y: 0,
      opacity: 1,
      duration: 1.2,
      ease: "power3.out",
    });

    // Mision text
    gsap.to("#mvv-mision-text", {
      scrollTrigger: {
        id: "mvv-mision-text",
        trigger: "#mvv-mision-text",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
      y: 0,
      opacity: 1,
      duration: 1,
      delay: 0.3,
      ease: "power3.out",
    });

    // Mision accent line
    gsap.to("#mvv-mision-line", {
      scrollTrigger: {
        id: "mvv-mision-line",
        trigger: "#mvv-mision-line",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
      width: "100%",
      duration: 1.5,
      ease: "power2.inOut",
    });

    // ── STAGE 2: VISIÓN ──

    // Vision heading
    gsap.to("#mvv-vision-block h2", {
      scrollTrigger: {
        id: "mvv-vision-h2",
        trigger: "#mvv-vision-block",
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
      y: 0,
      opacity: 1,
      duration: 1.2,
      ease: "power3.out",
    });

    // Vision text
    gsap.to("#mvv-vision-text", {
      scrollTrigger: {
        id: "mvv-vision-text",
        trigger: "#mvv-vision-text",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
      y: 0,
      opacity: 1,
      duration: 1,
      delay: 0.3,
      ease: "power3.out",
    });

    // Vision accent line
    gsap.to("#mvv-vision-line", {
      scrollTrigger: {
        id: "mvv-vision-line",
        trigger: "#mvv-vision-line",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
      width: "60%",
      duration: 1.5,
      ease: "power2.inOut",
    });

    // ── STAGE 3: VALORES ──

    // Valores heading: scale-up
    gsap.to("#mvv-valores-heading", {
      scrollTrigger: {
        id: "mvv-valores-heading",
        trigger: "#mvv-valores-heading",
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
      scale: 1,
      opacity: 1,
      duration: 1.2,
      ease: "back.out(1.4)",
    });

    // Value cards: staggered bounce-in
    gsap.utils.toArray(".mvv-valor-card").forEach((card: any, i) => {
      gsap.to(card, {
        scrollTrigger: {
          id: `mvv-card-${i}`,
          trigger: card,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
        y: 0,
        opacity: 1,
        duration: 0.8,
        delay: i * 0.15,
        ease: "back.out(1.7)",
      });
    });

    // ── Scramble de los contadores 01-04 ──
    // Antes el handle del setInterval era local al onEnter, invisible desde
    // onLeaveBack: ese handler escribía el valor final y dejaba el intervalo
    // corriendo, que volvía a pisarlo con ruido.
    const counterIds = [
      "mvv-counter-1",
      "mvv-counter-2",
      "mvv-counter-3",
      "mvv-counter-4",
    ];
    const counterFinals = ["01", "02", "03", "04"];
    const nothingIsStatic = () => false;

    counterIds.forEach((id, i) => {
      const el = document.getElementById(id);
      if (!el) return;
      const final = counterFinals[i];

      ScrollTrigger.create({
        id: `mvv-counter-${i}`,
        trigger: el,
        start: "top bottom",
        end: "top 85%",
        onEnter: () => playScramble(el, final, nothingIsStatic),
        onLeave: () => freezeScramble(el, final),
        onEnterBack: () => freezeScramble(el, final),
        onLeaveBack: () => armScramble(el, final, nothingIsStatic),
      });

      if (el.getBoundingClientRect().top < window.innerHeight * 0.85) {
        freezeScramble(el, final);
      }
    });
  };

  // Run on initial load
  initMVVAnimations();

  // Re-run after View Transition page swaps
  document.addEventListener("astro:page-load", initMVVAnimations);
</script>
