---
import TechStackMarquee from "./TechStackMarquee.astro";
---

<section
  id="nosotros"
  aria-labelledby="about-heading"
  class="py-32 relative overflow-hidden"
>
  <!-- Decorative background elements -->
  <div
    class="absolute top-1/2 right-0 -translate-y-1/2 w-[500px] h-[500px] bg-accent-blue/10 rounded-full blur-[100px] z-0 pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- Vision Header -->
    <div
      data-reveal
      class="max-w-4xl mx-auto text-center mb-24 opacity-0 reveal-up-sm"
      id="about-header"
    >
      <span
        class="text-accent-cyan font-bold tracking-widest uppercase text-sm mb-4 block"
        >Nuestra Filosofía</span
      >
      <h2
        id="about-heading"
        class="font-heading text-4xl md:text-6xl font-bold mb-8 leading-tight"
      >
        No hacemos «sitios web». <br class="hidden md:inline" />
        <span class="text-gradient">Diseñamos Activos Digitales.</span>
      </h2>
      <p
        class="text-gray-400 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto"
      >
        Dakodev nace para cerrar la brecha entre el diseño estético y la
        ingeniería robusta. Liderados por especialistas en sistemas, aplicamos
        estándares corporativos a cada proceso que digitalizamos.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-32">
      <!-- Card 1 -->
      <div
        data-reveal
        class="glass p-8 rounded-3xl border border-white/10 opacity-0 reveal-up hover:border-accent-cyan/50 transition-colors duration-500 about-card"
      >
        <div class="text-5xl mb-6 text-accent-cyan" aria-hidden="true">01.</div>
        <h3 class="font-heading text-2xl font-bold mb-4">Ingeniería que Escala</h3>
        <p class="text-gray-400 leading-relaxed">
          Código limpio, escalable y mantenible — SOLID, sin parches. El sistema
          que ponemos hoy aguanta el volumen que vas a tener en tres años.
        </p>
      </div>

      <!-- Card 2 -->
      <div
        data-reveal
        class="glass p-8 rounded-3xl border border-white/10 opacity-0 reveal-up hover:border-accent-blue/50 transition-colors duration-500 about-card"
      >
        <div class="text-5xl mb-6 text-accent-blue" aria-hidden="true">02.</div>
        <h3 class="font-heading text-2xl font-bold mb-4">Diseño Estratégico</h3>
        <p class="text-gray-400 leading-relaxed">
          Cada pantalla tiene un propósito: menos pasos por tarea. Un sistema
          que el equipo evita usar no ahorra nada.
        </p>
      </div>

      <!-- Card 3 -->
      <div
        data-reveal
        class="glass p-8 rounded-3xl border border-white/10 opacity-0 reveal-up hover:border-accent-teal/50 transition-colors duration-500 about-card"
      >
        <div class="text-5xl mb-6 text-accent-teal" aria-hidden="true">03.</div>
        <h3 class="font-heading text-2xl font-bold mb-4">Transparencia</h3>
        <p class="text-gray-400 leading-relaxed">
          Comunicación directa y sin tecnicismos innecesarios. Vas a saber
          exactamente qué estamos construyendo y por qué.
        </p>
      </div>
    </div>

    <!-- Tech Stack -->
  </div>

  <!-- Tech Stack (full-width, outside container) -->
  <div class="opacity-0" id="tech-stack-section" data-reveal>
    <h3 class="text-center font-heading text-2xl font-bold mb-12 text-gray-400">
      Tecnologías que Usamos
    </h3>
    <TechStackMarquee />
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAboutAnimations = () => {
    const root = document.getElementById("nosotros");
    if (!root) return;

    // Astro dispara astro:page-load también en la carga inicial, así que esta
    // función corría dos veces por página. Con View Transitions el nodo se
    // reemplaza, por eso el flag vive en el DOM y no en el módulo.
    if (root.dataset.animated === "true") {
      ScrollTrigger.refresh();
      return;
    }
    root.dataset.animated = "true";

    // Con movimiento reducido el CSS ya deja visible todo lo que tiene
    // data-reveal; no hace falta (ni conviene) animar nada.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Kill only THIS section's ScrollTriggers (scoped to about- prefix)
    ScrollTrigger.getAll()
      .filter((st: any) => st.vars?.id?.startsWith("about-"))
      .forEach((st) => st.kill());

    // Animate Header
    gsap.to("#about-header", {
      scrollTrigger: {
        id: "about-header",
        trigger: "#about-header",
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
      y: 0,
      opacity: 1,
      duration: 1,
      ease: "power3.out",
    });

    // Animate Cards Staggered
    gsap.utils.toArray(".about-card").forEach((card: any, i) => {
      gsap.to(card, {
        scrollTrigger: {
          id: `about-card-${i}`,
          trigger: card,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
        y: 0,
        opacity: 1,
        duration: 0.8,
        delay: i * 0.2,
        ease: "back.out(1.7)",
      });
    });

    // Animate Tech Stack
    gsap.to("#tech-stack-section", {
      scrollTrigger: {
        id: "about-tech",
        trigger: "#tech-stack-section",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
      opacity: 1,
      duration: 1.5,
      ease: "power2.inOut",
    });
  };

  // Run on initial load
  initAboutAnimations();

  // Re-run after View Transition page swaps
  document.addEventListener("astro:page-load", initAboutAnimations);
</script>
