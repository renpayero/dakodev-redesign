---
import logoMark from "../assets/logo-mark.svg?raw";
---

<div
  id="loader"
  aria-hidden="true"
  inert
  class="fixed inset-0 z-[100] bg-dark flex flex-col items-center justify-center"
>
  <div class="relative flex items-center gap-4">
    <!-- Logo Icon Building -->
    <div
      class="w-16 h-16 opacity-0 reveal-zoom-50 drop-shadow-[0_0_40px_rgba(0,245,212,0.3)]"
      id="loader-icon"
      set:html={logoMark}
    />


    <!-- Text Typewriter / Decoding -->
    <div class="overflow-hidden">
      <!-- Monospaced font helps the effect look more technical -->
      <div
        class="font-wordmark font-bold text-4xl md:text-5xl tracking-tight text-white reveal-down-full"
        id="loader-text"
        aria-hidden="true"
      >
        Dakodev
      </div>
    </div>
  </div>

  <!-- Loading Line -->
  <div
    class="w-64 h-1 bg-white/10 rounded-full mt-8 overflow-hidden opacity-0"
    id="loader-line-container"
  >
    <div class="h-full bg-accent-cyan w-0" id="loader-line"></div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { TextPlugin } from "gsap/TextPlugin";

  gsap.registerPlugin(TextPlugin);

  const initLoader = () => {
    const loader = document.getElementById("loader");
    if (!loader) return;

    // Con movimiento reducido el loader no debe tapar la pantalla 3,5s con una
    // animación que el usuario pidió no ver, y que además no puede interrumpir.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      sessionStorage.setItem("loader-ran", "true");
      document.body.classList.add("hero-quick-load");
      loader.style.display = "none";
      return;
    }

    const skipLoader = () => {
      sessionStorage.setItem("loader-ran", "true");
      document.body.classList.add("hero-quick-load");
      loader.style.display = "none";
    };

    // Check if loader already ran in this session
    if (sessionStorage.getItem("loader-ran")) {
      loader.style.display = "none";
      document.body.classList.add("hero-quick-load"); // Enable fast animations
      return;
    }

    // Si la pestaña se abrió en segundo plano (Ctrl+click, restaurar sesión),
    // el navegador suspende requestAnimationFrame y GSAP no avanza: la
    // animación quedaría congelada tapando el sitio. En ese caso no tiene
    // sentido mostrar una intro que nadie está mirando.
    if (document.visibilityState === "hidden") {
      skipLoader();
      return;
    }

    // Ensure class is removed if loader IS showing (rare case of manual refresh clearing session but cached page?)
    document.body.classList.remove("hero-quick-load");

    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem("loader-ran", "true");
        gsap.to("#loader", {
          duration: 0.8,
          opacity: 0,
          pointerEvents: "none",
          ease: "power2.inOut",
          onComplete: () => {
            document.body.classList.add("hero-quick-load"); // Enable fast animations for next scrolls/interactivity
            if (loader) loader.style.display = "none";
          },
        });
      },
    });

    // Scramble Text Effect Logic
    const originalText = "Dakodev";
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()";

    function scrambleText(
      element: HTMLElement,
      finalState: string,
      duration: number,
    ) {
      let iterations = 0;
      const maxIterations = duration * 60;

      const interval = setInterval(() => {
        element.innerText = finalState
          .split("")
          .map((letter, index) => {
            if (index < iterations / (maxIterations / finalState.length)) {
              return finalState[index];
            }
            return chars[Math.floor(Math.random() * chars.length)];
          })
          .join("");

        if (iterations >= maxIterations) {
          clearInterval(interval);
          element.innerText = finalState;
        }
        iterations += 1;
      }, 1000 / 60);
    }

    tl.to("#loader-icon", {
      opacity: 1,
      scale: 1,
      duration: 0.8,
      ease: "back.out(1.7)",
    })
      .to(
        "#loader-text",
        {
          y: 0,
          opacity: 1,
          duration: 0.1,
          onStart: () => {
            const el = document.getElementById("loader-text");
            if (el) scrambleText(el, "Dakodev", 1.0);
          },
        },
        "-=0.2",
      )
      .to({}, { duration: 1.0 })
      .to(
        "#loader-line-container",
        {
          opacity: 1,
          duration: 0.3,
        },
        "-=0.5",
      )
      .to("#loader-line", {
        width: "100%",
        duration: 0.8,
        ease: "power1.inOut",
      });

    // Red de seguridad: el loader tapa todo el viewport en z-100, así que si
    // por cualquier motivo la timeline no llegara a completarse, el sitio
    // quedaría inutilizable. Pasado el doble de su duración, se cierra igual.
    window.setTimeout(() => {
      if (loader.style.display !== "none") {
        tl.kill();
        skipLoader();
      }
    }, 8000);
  };

  // Run on first load
  initLoader();

  // Run after View Transitions swap
  document.addEventListener("astro:after-swap", initLoader);
</script>
